                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Client": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Id"
                    },
                    "first_name": {
                        "type": "string",
                        "title": "First Name"
                    },
                    "last_name": {
                        "type": "string",
                        "title": "Last Name"
                    },
                    "email": {
                        "type": "string",
                        "title": "Email"
                    },
                    "description": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Description"
                    },
                    "social_links": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Social Links"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "first_name",
                    "last_name",
                    "email",
                    "description",
                    "social_links",
                    "created_at"
                ],
                "title": "Client"
            },
            "ClientCreate": {
                "properties": {
                    "first_name": {
                        "type": "string",
                        "maxLength": 200,
                        "minLength": 1,
                        "title": "First Name"
                    },
                    "last_name": {
                        "type": "string",
                        "maxLength": 200,
                        "minLength": 1,
                        "title": "Last Name"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "title": "Email"
                    },
                    "description": {
                        "anyOf": [
                            {
                                "type": "string",
                                "maxLength": 10000
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Description"
                    },
                    "social_links": {
                        "items": {
                            "type": "string",
                            "maxLength": 2000,
                            "minLength": 1
                        },
                        "type": "array",
                        "maxItems": 50,
                        "title": "Social Links"
                    }
                },
                "type": "object",
                "required": [
                    "first_name",
                    "last_name",
                    "email"
                ],
                "title": "ClientCreate",
                "examples": [
                    {
                        "description": "Tech founder, interested in sustainable investing.",
                        "email": "john.doe@neviswealth.com",
                        "first_name": "John",
                        "last_name": "Doe",
                        "social_links": [
                            "https://www.linkedin.com/in/johndoe"
                        ]
                    }
                ]
            },
            "ClientSearchResult": {
                "properties": {
                    "type": {
                        "type": "string",
                        "const": "client",
                        "title": "Type",
                        "default": "client"
                    },
                    "score": {
                        "type": "number",
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Score"
                    },
                    "matched_by": {
                        "items": {
                            "type": "string",
                            "enum": [
                                "name",
                                "email",
                                "description"
                            ]
                        },
                        "type": "array",
                        "title": "Matched By"
                    },
                    "client": {
                        "$ref": "#/components/schemas/Client"
                    }
                },
                "type": "object",
                "required": [
                    "score",
                    "matched_by",
                    "client"
                ],
                "title": "ClientSearchResult"
            },
            "Document": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Id"
                    },
                    "client_id": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Client Id"
                    },
                    "title": {
                        "type": "string",
                        "title": "Title"
                    },
                    "content": {
                        "type": "string",
                        "title": "Content"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "client_id",
                    "title",
                    "content",
                    "created_at"
                ],
                "title": "Document"
            },
            "DocumentCreate": {
                "properties": {
                    "title": {
                        "type": "string",
                        "maxLength": 500,
                        "minLength": 1,
                        "title": "Title"
                    },
                    "content": {
                        "type": "string",
                        "maxLength": 500000,
                        "minLength": 1,
                        "title": "Content"
                    }
                },
                "type": "object",
                "required": [
                    "title",
                    "content"
                ],
                "title": "DocumentCreate",
                "examples": [
                    {
                        "content": "Electricity utility bill issued to John Doe, 12 Baker Street, London. Amount due: 84.20 GBP.",
                        "title": "Utility bill - March 2026"
                    }
                ]
            },
            "DocumentSearchResult": {
                "properties": {
                    "type": {
                        "type": "string",
                        "const": "document",
                        "title": "Type",
                        "default": "document"
                    },
                    "score": {
                        "type": "number",
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Score"
                    },
                    "matched_by": {
                        "items": {
                            "type": "string",
                            "enum": [
                                "keyword",
                                "semantic"
                            ]
                        },
                        "type": "array",
                        "title": "Matched By"
                    },
                    "snippet": {
                        "type": "string",
                        "title": "Snippet",
                        "description": "The passage of the document that best matches the query."
                    },
                    "document": {
                        "$ref": "#/components/schemas/Document"
                    }
                },
                "type": "object",
                "required": [
                    "score",
                    "matched_by",
                    "snippet",
                    "document"
                ],
                "title": "DocumentSearchResult"
            },
            "DocumentSummary": {
                "properties": {
                    "document_id": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Document Id"
                    },
                    "summary": {
                        "type": "string",
                        "title": "Summary"
                    },
                    "method": {
                        "type": "string",
                        "enum": [
                            "llm",
                            "extractive"
                        ],
                        "title": "Method",
                        "description": "`llm` when generated by the configured LLM, `extractive` when built from the document's most representative sentences (no LLM configured or LLM unavailable)."
                    }
                },
                "type": "object",
                "required": [
                    "document_id",
                    "summary",
                    "method"
                ],
                "title": "DocumentSummary"
            },
            "ErrorResponse": {
                "properties": {
                    "detail": {
                        "type": "string",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "required": [
                    "detail"
                ],
                "title": "ErrorResponse"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        },
        "securitySchemes": {
            "APIKeyHeader": {
                "type": "apiKey",
                "description": "Required only when the server is started with API_KEY set.",
                "in": "header",
                "name": "X-API-Key"
            }
        }
    }
}
