# Copy to .env and fill in. .env is gitignored: secrets never get committed.
#   cp .env.example .env
# Everything here is optional: without a .env the service runs with the defaults below.
# docker compose passes this file to the API container; local runs (uv run ...) read it too.

# --- Postgres (read by docker-compose) ---
POSTGRES_USER=search
# The database is reachable only from the host (127.0.0.1), but change it on a server anyway.
POSTGRES_PASSWORD=search
POSTGRES_DB=search
# Host port; 5433 to avoid clashing with a locally running Postgres.
POSTGRES_PORT=5433

# --- Database (read by the application) ---
# Locally this is localhost; inside compose the host is overridden to `db`.
DATABASE_URL=postgresql+asyncpg://search:search@localhost:5433/search
# Connection pool per worker process.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- HTTP server ---
# Host port of the API container (on a server without a reverse proxy: 80).
API_PORT=8000
# Worker processes. Each loads its own copy of the embedding model; more workers did not
# raise throughput in measurements (CPU-bound, see README "Concurrency and performance").
WEB_CONCURRENCY=1
# When set, every endpoint except /health requires this value in the X-API-Key header.
# Set it on any instance reachable by others, especially with ANTHROPIC_API_KEY below:
# every new search query can trigger a billed LLM call.
API_KEY=

# --- LLM (optional): document summaries and query expansion ---
# Without a key: extractive summaries and thesaurus-only query expansion.
# Measured cost with Claude Haiku 4.5: ~$0.0005 per new search query, ~$0.001 per summary.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
# false = keep LLM summaries but never call the LLM from /search (saves 0.7-2 s per new query).
LLM_QUERY_EXPANSION=true
LLM_TIMEOUT_SECONDS=10

# --- Embeddings: local, fastembed/ONNX, no API calls ---
# The Docker image ships with this model; changing it needs a new migration if the vector
# dimension differs (checked at startup), and the container then downloads the model.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Local runs only (the image sets its own): where fastembed keeps model files.
# EMBEDDING_CACHE_DIR=.cache/fastembed
# ONNX Runtime threads per embedding call. Empty = one per physical core.
EMBEDDING_THREADS=

# --- Search tuning (defaults shown) ---
# Cosine similarity below which a semantic-only match counts as noise (model-specific).
MIN_SEMANTIC_SIMILARITY=0.3
# pg_trgm strict word similarity required for a fuzzy (typo-tolerant) client match.
CLIENT_FUZZY_THRESHOLD=0.4
